# ---------- Server (server/.env) ----------
PORT=4000
# Leave empty to use an in-memory MongoDB that auto-seeds demo data on start (zero-setup demo).
MONGODB_URI=
JWT_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
CLIENT_ORIGIN=http://localhost:5173
TZ=Asia/Kolkata

# Offline demo mode: every external adapter (LLM, RSS, Google Trends, news, mandi prices, SMTP) replays fixtures.
FIXTURE_MODE=true
AUTO_SEED=true
ENABLE_CRON=true
ADMIN_EMAILS=

# AI via Groq (free tier, https://console.groq.com). Without a key, the agent uses the deterministic rules planner (zero tokens).
GROQ_API_KEY=
LLM_MODEL_AGENT=openai/gpt-oss-120b
LLM_MODEL_EXTRACT=openai/gpt-oss-20b
# Prompt-injection screen for incoming article text (set empty to disable)
LLM_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
LLM_DAILY_TOKEN_BUDGET=200000
# With a GROQ_API_KEY the agent plans with the LLM (also in FIXTURE_MODE, where only data is offline). false = force rules planner.
AGENT_USE_LLM=true

# PayPal Developer (sandbox). Without these, payments run in a clearly-labelled simulated mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_FX_INR_TO_CURRENCY=0.012

# Real-mode data sources (FIXTURE_MODE=false)
NEWS_API_PROVIDER=
NEWS_API_KEY=
MANDI_API_KEY=
MANDI_RESOURCE_ID=
TRENDS_PROXY_URL=
SMTP_URL=

# Payments placeholder kept from the original spec (Razorpay replaced by PayPal; see docs/DECISIONS.md)
PAYMENTS_ENABLED=false

# ---------- Client (client/.env) ----------
VITE_API_URL=
